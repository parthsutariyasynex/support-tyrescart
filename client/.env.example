NEXT_PUBLIC_API_URL=http://localhost:4000
# Where Next.js forwards /graphql, /auth, /webhook and /socket.io (default http://127.0.0.1:5000).
# On macOS use another port: 5000 is taken by the AirPlay Receiver (403 "AirTunes").
# API_PROXY_TARGET=http://127.0.0.1:5001

# Map pictures in the chat and the Location screen (a {z}/{x}/{y} tile server and its credit line; default
# OpenStreetMap, free for light use: https://operations.osmfoundation.org/policies/tiles/)
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors
