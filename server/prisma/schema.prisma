// SQLite for local dev. For production switch provider to "postgresql"
// and set DATABASE_URL to your Postgres connection string.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                String               @id @default(cuid())
  email             String               @unique
  name              String
  // Settings → General → Profile: your own phone number (international format, e.g. +971501234567) and job title
  phone             String?              @db.VarChar(30)
  jobTitle          String?              @db.VarChar(100)
  // Settings → General → System preference: IANA time zone for showing dates (null = the app default, Dubai)
  timeZone          String?              @db.VarChar(64)
  // Settings → WhatsApp QR code: the first message filled in for customers who open your link (null = none)
  qrMessage         String?              @db.VarChar(300)
  // Profile picture (Settings → General): the file is uploads/avatars/<user id>; null = none (initial shown)
  avatarMime        String?              @db.VarChar(50)
  avatarUpdatedAt   DateTime?
  passwordHash      String
  createdAt         DateTime             @default(now())
  // --- standard audit fields (who/when; nullable for system-created rows; soft-delete columns are informational,
  // --- deletes stay as they are) ---
  createdBy         String?
  updatedAt         DateTime             @default(now()) @updatedAt
  updatedBy         String?
  deletedAt         DateTime?
  deletedBy         String?
  // active | inactive (record status)
  status            String               @default("active")
  members           Member[]
  // Set when the password is reset; login tokens issued before it stop working
  passwordChangedAt DateTime?
  resetTokens       PasswordResetToken[]
}

model Workspace {
  id               String                  @id @default(cuid())
  name             String
  createdAt        DateTime                @default(now())
  // --- standard audit fields (who/when; nullable for system-created rows; soft-delete columns are informational,
  // --- deletes stay as they are) ---
  createdBy        String?
  updatedAt        DateTime                @default(now()) @updatedAt
  updatedBy        String?
  deletedAt        DateTime?
  deletedBy        String?
  // active | inactive (record status)
  status           String                  @default("active")
  members          Member[]
  whatsapp         WhatsAppAccount?
  whatsappBackups  WhatsAppAccountBackup[]
  contacts         Contact[]
  conversations    Conversation[]
  labels           Label[]
  activity         ActivityEvent[]
  quickReplies     QuickReply[]
  assignments      AssignmentRecord[]
  contactRemarks   ContactRemark[]
  contactLists     ContactList[]
  propertyViews    ContactPropertyView[]
  propertyDefault  ContactPropertyDefault?
  customProperties ContactCustomProperty[]
  leadStages       LeadStage[]
  settings         WorkspaceSettings?
  automation       AutomationSettings?
  aiRobot          AiRobotSettings?
  fieldChoices     ContactFieldChoice[]
  vehicles         Vehicle[]
}

model Member {
  id                    String         @id @default(cuid())
  role                  String         @default("agent") // owner | admin | supervisor | agent
  // Agents need this to create, edit or delete labels and assignees (owners and admins always can)
  canManageLabels       Boolean        @default(false)
  // false: deactivated by an admin for this workspace. They can't sign in to it, their sessions and Socket.IO
  // connections are closed, and they can't be assigned chats. Their account and other workspaces are untouched.
  active                Boolean        @default(true)
  // Bell: events after this time count as unseen for this member
  notificationsSeenAt   DateTime?
  userId                String
  workspaceId           String
  createdAt             DateTime       @default(now())
  // --- standard audit fields (who/when; nullable for system-created rows; soft-delete columns are informational,
  // --- deletes stay as they are) ---
  createdBy             String?
  updatedAt             DateTime       @default(now()) @updatedAt
  updatedBy             String?
  deletedAt             DateTime?
  deletedBy             String?
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace             Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Chats assigned to this member (Conversation.assignedToId); removing the member unassigns them
  assignedConversations Conversation[]

  @@unique([userId, workspaceId])
  @@map("Role")
}

// One connected WhatsApp number per workspace (from Embedded Signup or manual setup)
model WhatsAppAccount {
  id            String    @id @default(cuid())
  workspaceId   String    @unique
  wabaId        String
  phoneNumberId String    @unique
  displayPhone  String?
  accessToken   String    @db.Text // encrypt at rest in production
  createdAt     DateTime  @default(now())
  // --- standard audit fields (who/when; nullable for system-created rows; soft-delete columns are informational,
  // --- deletes stay as they are) ---
  createdBy     String?
  updatedAt     DateTime  @default(now()) @updatedAt
  updatedBy     String?
  deletedAt     DateTime?
  deletedBy     String?
  // active | inactive (record status)
  status        String    @default("active")
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// Previous WhatsApp credentials of a workspace, kept when connectWhatsApp replaces them (newest first by replacedAt),
// so a replaced number can be restored: npm run whatsapp:restore. Holds the old access token: server only.
model WhatsAppAccountBackup {
  id            String    @id @default(cuid())
  workspaceId   String
  wabaId        String
  phoneNumberId String
  displayPhone  String?
  accessToken   String    @db.Text
  replacedAt    DateTime  @default(now())
  replacedBy    String?
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, replacedAt])
}

// Audit trail of WhatsApp connection changes (Settings → WhatsApp connection activity): every Connect / Update /
// Replace attempt (who, which workspace, previous and new number, the 7 checks with Meta, saved or why not, backup
// made) and every restore (npm run whatsapp:restore). Never holds tokens, app secrets, JWTs or passwords (redacted
// in services/whatsappAudit.ts). Not pruned by the log retention clean-up. createdAt is UTC; shown in Asia/Dubai.
model WhatsAppConnectionLog {
  id                    String   @id @default(cuid())
  createdAt             DateTime @default(now())
  workspaceId           String
  // Who did it (null for a restore run from the command line); name and email as they were at the time
  actorId               String?
  actorName             String?  @db.VarChar(191)
  actorEmail            String?  @db.VarChar(191)
  // connect (no number before) | replace (another number) | update (same number, new token or account) | restore
  action                String   @db.VarChar(20)
  // success | failed
  status                String   @db.VarChar(10)
  // settings (the web app / GraphQL) | api (REST) | script (command line)
  source                String   @db.VarChar(20)
  previousDisplayPhone  String?  @db.VarChar(50)
  previousPhoneNumberId String?  @db.VarChar(64)
  previousWabaId        String?  @db.VarChar(64)
  newDisplayPhone       String?  @db.VarChar(50)
  phoneNumberId         String?  @db.VarChar(64)
  wabaId                String?  @db.VarChar(64)
  // The checks with Meta that ran: [{ name, ok, detail }] (stops at the first failure; null when none ran)
  checks                Json?
  checksPassed          Int      @default(0)
  // Credentials backup made before the save (WhatsAppAccountBackup id), or the backup a restore used
  backupCreated         Boolean  @default(false)
  backupId              String?  @db.VarChar(64)
  errorCode             String?  @db.VarChar(50)
  errorReason           String?  @db.Text

  @@index([workspaceId, createdAt])
  @@index([actorId, createdAt])
  @@index([status, createdAt])
}

model Contact {
  id            String               @id @default(cuid())
  workspaceId   String
  waId          String // phone number in international format, no +
  name          String?
  tags          String               @default("") // comma separated; use a Tag table later
  // --- Profile (chat side panel "Contact property"; all optional, edited by the team) ---
  firstName     String?              @db.VarChar(100)
  lastName      String?              @db.VarChar(100)
  email         String?              @db.VarChar(191)
  companyName   String?              @db.VarChar(150)
  jobTitle      String?              @db.VarChar(100)
  // new | contacted | qualified | proposal | won | lost
  leadStage     String?              @db.VarChar(20)
  // whatsapp | website | referral | walk_in | phone_call | social_media | other
  leadSource    String?              @db.VarChar(20)
  // low | medium | high | urgent
  priority      String?              @db.VarChar(10)
  // Set by the team; when empty the panel shows the country of the phone number's calling code
  country       String?              @db.VarChar(100)
  // Whether the customer wants messages from you (team-managed; new contacts start subscribed)
  subscribed    Boolean              @default(true)
  // From WhatsApp's webhook when it sends them: business-scoped user ID and the customer's WhatsApp username
  waBsuid       String?              @db.VarChar(191)
  waUsername    String?              @db.VarChar(100)
  remarks       ContactRemark[]
  customValues  ContactCustomValue[]
  listMembers   ContactListMember[]
  vehicles      Vehicle[]
  createdAt     DateTime             @default(now())
  // --- standard audit fields (who/when; nullable for system-created rows; soft-delete columns are informational,
  // --- deletes stay as they are) ---
  createdBy     String?
  updatedAt     DateTime             @default(now()) @updatedAt
  updatedBy     String?
  deletedAt     DateTime?
  deletedBy     String?
  // active | inactive (record status)
  status        String               @default("active")
  workspace     Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([workspaceId, waId])
}

model Conversation {
  id               String                     @id @default(cuid())
  workspaceId      String
  contactId        String
  // The workspace member (Member.id, table Role) who holds this chat; null = unassigned (a New Lead)
  assignedToId     String?
  // When the current assignee first opened the chat after it was assigned to them; null = not yet. Cleared on
  // every assignment change, so reminders (services/assignmentReminders.ts) run until they open it.
  assigneeOpenedAt DateTime?
  // When the current assignee got it (set on every assignment change; null when unassigned or assigned before
  // this column existed, then updatedAt stands in). Reminders count 5 minutes from here.
  assignedAt       DateTime?
  // Last reminder sent for this chat (persisted, so restarts don't reset the 5-minute timer or send duplicates)
  reminderSentAt   DateTime?
  // Simple automations: when this chat last got an automatic reply (not repeated within the cooldown)
  lastAutoReplyAt  DateTime?
  lastMessageAt    DateTime                   @default(now())
  // Customer's last inbound message: free-form replies allowed for 24h after this
  lastInboundAt    DateTime?
  // Follow-up after 24 hours (Simple automations): when one was last sent; another only after the customer writes again
  followUpSentAt   DateTime?
  unread           Int                        @default(0)
  // open | snoozed | closed. Closing keeps messages, labels and the assignee; new customer messages don't reopen it
  // (they do wake a snoozed chat)
  status           String                     @default("open")
  closedAt         DateTime?
  closedById       String?
  // status = snoozed: back to open at this time (or as soon as the customer writes); null otherwise
  snoozedUntil     DateTime?
  createdAt        DateTime                   @default(now())
  // --- standard audit fields (who/when; nullable for system-created rows; soft-delete columns are informational,
  // --- deletes stay as they are) ---
  createdBy        String?
  updatedAt        DateTime                   @default(now()) @updatedAt
  updatedBy        String?
  deletedAt        DateTime?
  deletedBy        String?
  workspace        Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact          Contact                    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages         Message[]
  labels           ConversationLabel[]
  assignedTo       Member?                    @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  activity         ActivityEvent[]
  clears           ConversationClear[]
  // Pinned to the top of these people's lists (per person). No longer used: pins are for the whole team (pinnedAt)
  pins             ConversationPin[]
  // Pinned for the whole team (owners/admins pin it): at the top of everyone's list; null when not pinned
  pinnedAt         DateTime?
  pinnedBy         String?
  // Teammates added to help on this chat (besides the assignee); they get its notifications
  collaborators    ConversationCollaborator[]
  // Assignment report rows (reasons). Never read by the chat API; see services/assignmentReports.ts
  assignments      AssignmentRecord[]
  // AI Summary (services/ai.ts): one per chat, replaced in place when regenerated
  aiSummary        ConversationSummary?
  // AI Robot (services/aiRobot.ts): automatic replies in unassigned chats.
  //   aiRobotState: null = may wait and reply (5 min, then instant) | active = has replied, answers instantly |
  //   stopped (a person replied, assigned, snoozed, Stop robot) | handover (the robot handed the chat to the team).
  //   aiRobotReason: why it stopped. Closing the chat starts a new robot session (state cleared, aiRobotSessionAt =
  //   closing time). aiRobotLastInId: the latest customer message the robot has handled (claimed with a
  //   compare-and-set update, so the same message is never answered twice)
  aiRobotState     String?                    @db.VarChar(12)
  aiRobotReason    String?                    @db.VarChar(30)
  aiRobotStateAt   DateTime?
  aiRobotSessionAt DateTime?
  aiRobotLastInId  String?                    @db.VarChar(191)
  aiRobotRuns      AiRobotRun[]

  @@unique([workspaceId, contactId])
  @@index([workspaceId, pinnedAt])
  @@index([workspaceId, lastMessageAt])
  @@index([workspaceId, status, lastMessageAt])
  // Follow-up check: chats whose customer last wrote around 24 hours ago
  @@index([workspaceId, lastInboundAt])
}

model Message {
  id               String            @id @default(cuid())
  conversationId   String
  waMessageId      String?           @unique
  direction        String // in | out
  type             String // text | template | image | ...
  body             String            @db.Text
  status           String            @default("sent") // pending | sent | delivered | read | failed
  error            String?           @db.Text
  // Images and documents your team sends, and media customers send (downloaded from WhatsApp): a copy kept on the
  // server (path under UPLOADS_DIR), its type and size in bytes. Null for text and templates.
  mediaPath        String?           @db.VarChar(255)
  mediaMime        String?           @db.VarChar(100)
  mediaSize        Int?
  // Documents: the file name shown in the chat and sent to WhatsApp
  mediaName        String?           @db.VarChar(255)
  // Media a customer sent: WhatsApp's id for it, used to download the file (then mediaPath is set)
  waMediaId        String?           @db.VarChar(191)
  createdAt        DateTime          @default(now())
  // Outgoing messages: the agent (user id) who sent it; null for customer messages and older rows
  sentById         String?
  editedAt         DateTime?
  // "Delete for everyone": body is cleared, the row stays so the conversation keeps its shape
  deletedAt        DateTime?
  deletedById      String?
  // Bumped on every edit/delete so concurrent edits and late socket events can't overwrite newer content
  version          Int               @default(0)
  // Reactions, like WhatsApp: one from the customer and one from the business (the team shares the business
  // number, so a teammate's reaction replaces another's). null = none.
  customerReaction String?           @db.VarChar(32)
  teamReaction     String?           @db.VarChar(32)
  teamReactionById String?
  // Sent by Simple automations (e.g. "auto_reply"), not by a person; null for everything else
  automation       String?           @db.VarChar(20)
  // A reply, as in WhatsApp: the message in this chat it quotes (a teammate's reply, or a customer's reply to one
  // of ours); null for everything else
  replyToId        String?
  // Pinned in its chat for the whole team (owners/admins; the bar at the top of the chat); null when not pinned
  pinnedAt         DateTime?
  pinnedBy         String?
  // --- standard audit fields (sentById = createdBy, deletedById = deletedBy, status = delivery status) ---
  updatedAt        DateTime          @default(now()) @updatedAt
  updatedBy        String?
  conversation     Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  revisions        MessageRevision[]

  @@index([conversationId, createdAt])
}

// Previous text of a message, saved on each edit or delete. Server-side history only; never returned by the API.
model MessageRevision {
  id        String   @id @default(cuid())
  messageId String
  body      String   @db.Text
  // edit | delete | restore
  action    String
  userId    String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, createdAt])
}

// WhatsApp Business-style labels, shared by everyone in the workspace
model Label {
  id            String              @id @default(cuid())
  workspaceId   String
  name          String              @db.VarChar(50)
  color         String              @db.VarChar(7) // #rrggbb
  createdAt     DateTime            @default(now())
  // --- standard audit fields (who/when; nullable for system-created rows; soft-delete columns are informational,
  // --- deletes stay as they are) ---
  createdBy     String?
  updatedAt     DateTime            @default(now()) @updatedAt
  updatedBy     String?
  deletedAt     DateTime?
  deletedBy     String?
  // active | inactive (record status)
  status        String              @default("active")
  workspace     Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations ConversationLabel[]

  @@unique([workspaceId, name])
}

model ConversationLabel {
  conversationId String
  labelId        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  label          Label        @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([conversationId, labelId])
  @@index([labelId])
}

// "Forgot password" links. Only a SHA-256 hash of the secret is stored; each link expires and works once.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Activity history (chat timeline + notification bell). Never stores message text except a short
// preview of incoming customer messages.
model ActivityEvent {
  id             String        @id @default(cuid())
  workspaceId    String
  conversationId String?
  // User who did it; null for the customer / system
  actorId        String?
  // conversation_closed | conversation_reopened | assigned | reassigned | unassigned | label_added | label_removed |
  // message_edited | message_deleted | message_restored | message_received
  type           String
  data           Json?
  createdAt      DateTime      @default(now())
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([workspaceId, createdAt])
}

// One row per assignment, reassignment or unassignment of a chat, with the optional reason the person gave.
// Append-only: a reassignment adds a row, it never changes or removes earlier ones. This is report data: it is
// NOT part of the chat history (ActivityEvent), is never included in conversation/message queries or socket
// events, and is only read by the admin-only assignment report (services/assignmentReports.ts).
// Names are copied at the time so the report still reads correctly after a member is removed.
model AssignmentRecord {
  id               String       @id @default(cuid())
  workspaceId      String
  conversationId   String
  // Member ids (table Role) and user ids; null = the chat was unassigned before / after
  previousMemberId String?
  previousUserId   String?
  previousName     String?
  newMemberId      String?
  newUserId        String?
  newName          String?
  // Who did it (user id); null for a system change (e.g. a member being removed unassigns their chats)
  assignedById     String?
  assignedByName   String?
  // Optional reason typed in the Assign box; report-only
  reason           String?      @db.Text
  // The assignment timestamp
  createdAt        DateTime     @default(now())
  workspace        Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([conversationId, createdAt])
}

// "Pin conversation": keeps a chat at the top of one person's list (like WhatsApp; at most 3 per person and workspace)
model ConversationPin {
  userId         String
  conversationId String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([userId, conversationId])
  @@index([conversationId])
}

// Collaborators on a chat: workspace members added alongside the assignee (user ids)
model ConversationCollaborator {
  conversationId String
  userId         String
  addedById      String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

// "Clear chat" (only for the person who did it, like WhatsApp): messages and activity up to clearedAt are
// hidden from that user. Nothing is deleted; the customer and teammates still see everything.
model ConversationClear {
  userId         String
  conversationId String
  clearedAt      DateTime
  // Append-only: clearedAt is when the row was made; the composite key is the identity
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([userId, conversationId])
  @@index([conversationId])
}

// AI Summary of a chat (services/ai.ts), made by owners, admins and supervisors in the AI Assistant tab. One row per
// chat: Regenerate rewrites it (summary, lastMessageId, updatedAt, updatedBy); createdAt/createdBy stay the first
// time. lastMessageId: the newest message it covers, so the tab can say when newer messages came in.
model ConversationSummary {
  id             BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  conversationId String       @unique
  summary        String       @db.Text
  lastMessageId  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  createdBy      String?
  updatedBy      String?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

// WhatsApp Business-style quick replies: typing "/shortcut" in the message box offers these texts.
// Table Shortchat. Same columns as the TyresCart site's klever_tyres_chat table (its SQL dump is imported with
// scripts/importQuickReplies.ts),
// plus workspaceId so each workspace has its own set.
model QuickReply {
  id            Int       @id @default(autoincrement()) @db.UnsignedInt
  workspaceId   String
  shortcut      String    @db.VarChar(255)
  description   String?   @db.Text
  category      String?   @db.VarChar(50)
  // Admin user ids from the TyresCart site, kept as imported
  siteCreatedBy BigInt?   @map("created_by") @db.UnsignedBigInt
  siteUpdatedBy BigInt?   @map("updated_by") @db.UnsignedBigInt
  // This app's User ids: who added / last edited it here (null for imported rows)
  createdBy     String?   @map("created_by_user_id")
  updatedBy     String?   @map("updated_by_user_id")
  // 1 = enabled, 0 = disabled
  status        Int       @default(1) @db.SmallInt
  sortOrder     Int       @default(0) @map("sort_order")
  createdAt     DateTime? @default(now()) @map("created_at")
  updatedAt     DateTime? @updatedAt @map("updated_at")
  // Standard soft-delete columns (our user id; created_by/updated_by hold TyresCart site ids as imported)
  deletedAt     DateTime? @map("deleted_at")
  deletedBy     String?   @map("deleted_by")
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, sortOrder])
  @@map("Shortchat")
}

// Internal notes about a customer (chat side panel "Remarks"). Seen only by the team, never sent to the customer.
model ContactRemark {
  id          String       @id @default(cuid())
  workspaceId String
  contactId   String
  body        String       @db.Text
  createdById String?
  createdAt   DateTime     @default(now())
  // Last edit (null = never edited) and who made it
  editedAt    DateTime?
  editedById  String?
  contact     Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Images and documents attached to the note (Add note → 📎)
  files       RemarkFile[]

  @@index([contactId, createdAt])
  @@index([workspaceId])
}

// A file attached to an internal note (Add note → 📎): an image or a document, kept in the uploads folder. Only the
// team can open it (signed in, same workspace); it is never sent to WhatsApp or the customer. remarkId is null while
// it's uploaded but the note isn't saved yet; deleting the note deletes its files.
model RemarkFile {
  id          String         @id @default(cuid())
  workspaceId String
  contactId   String
  remarkId    String?
  path        String         @db.VarChar(255)
  name        String         @db.VarChar(255)
  mime        String         @db.VarChar(100)
  size        Int
  createdById String?
  createdAt   DateTime       @default(now())
  remark      ContactRemark? @relation(fields: [remarkId], references: [id], onDelete: Cascade)

  @@index([remarkId])
  @@index([workspaceId, createdById, createdAt])
}

// Contact lists (profile panel "Lists"): named groups of customers, e.g. VIP or Leads. Every member can create lists
// and add or remove customers; owners/admins delete lists.
model ContactList {
  id          String              @id @default(cuid())
  workspaceId String
  name        String              @db.VarChar(100)
  createdById String?
  createdAt   DateTime            @default(now())
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     ContactListMember[]

  @@unique([workspaceId, name])
}

model ContactListMember {
  listId    String
  contactId String
  addedById String?
  createdAt DateTime    @default(now())
  list      ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact   Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([listId, contactId])
  @@index([contactId])
}

// Each person's layout of the profile panel's "Contact property" (per workspace). Default view = every property in
// the standard order; personal view = this person's order and hidden properties. Keys are the panel's property keys.
// Settings → Company settings → Simple automations (admins): automatic replies when a customer writes (one text
// during working hours, another outside them; not repeated within cooldownHours for the same chat) and automatic
// assignment of new chats to chosen members in turn. Nothing runs while `enabled` is false.
model AutomationSettings {
  workspaceId          String    @id
  enabled              Boolean   @default(false)
  // Working days as day numbers, 0 = Sunday … 6 = Saturday, e.g. "1,2,3,4,5,6"; times are HH:MM in the
  // workspace's default time zone (Workspace preferences)
  workingDays          String    @default("1,2,3,4,5") @db.VarChar(20)
  workStart            String    @default("09:00") @db.VarChar(5)
  workEnd              String    @default("18:00") @db.VarChar(5)
  // Each working day's own hours, JSON like {"1":"09:00-18:00","6":"10:00-14:00"}; a day missing here uses
  // workStart-workEnd. "23:59" as an end means until midnight.
  dayHours             String?   @db.VarChar(300)
  replyInHoursEnabled  Boolean   @default(false)
  replyInHours         String?   @db.Text
  replyOutHoursEnabled Boolean   @default(false)
  replyOutHours        String?   @db.Text
  cooldownHours        Int       @default(24)
  routingEnabled       Boolean   @default(false)
  // specific (everything to the first member listed) | round_robin (in turn) | unassigned (left in New Leads)
  routingMode          String    @default("round_robin") @db.VarChar(20)
  // JSON array of member ids, assigned in turn; routingLastMemberId = who got the last one
  routingMemberIds     String?   @db.Text
  routingOnlineOnly    Boolean   @default(false)
  routingLastMemberId  String?
  // Follow-up after 24 hours: when a customer's last message is 24 hours old and they haven't written since, one
  // Meta-approved template is sent (once per quiet spell). On by default, but nothing is sent until a template is
  // chosen. followUpValues: JSON, each template variable -> a contact/company variable key, e.g.
  // {"body":{"1":"contact.first_name","2":"contact.last_name"}}. followUpActiveSince: when it became active (on, with
  // a template): only chats whose 24 hours run out after that get one, so old chats are never messaged in bulk.
  followUpEnabled      Boolean   @default(false)
  followUpTemplate     String?   @db.VarChar(512)
  followUpLanguage     String?   @db.VarChar(20)
  followUpValues       String?   @db.Text
  followUpActiveSince  DateTime?
  // --- standard audit fields (created when an admin first saves Simple automations) ---
  createdAt            DateTime  @default(now())
  createdBy            String?
  updatedAt            DateTime  @updatedAt
  updatedBy            String?
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// Settings → Company settings → Workspace preferences. null = the app's default (see services/workspaceSettings.ts)
model WorkspaceSettings {
  workspaceId                 String    @id
  defaultTimeZone             String?   @db.VarChar(64)
  defaultCountry              String?   @db.VarChar(2)
  businessDayStartHour        Int?
  reminderMinutes             Int?
  awayMinutes                 Int?
  deletedContactRetentionDays Int?
  // The most chats pinned for the whole team, and the most pinned messages in one chat (null: 5). Admins set it.
  pinLimit                    Int?
  updatedAt                   DateTime  @updatedAt
  updatedBy                   String?
  workspace                   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// Choices of the Lead source and Priority properties per workspace; contacts store `value`
model ContactFieldChoice {
  id          String    @id @default(cuid())
  workspaceId String
  field       String    @db.VarChar(20)
  value       String    @db.VarChar(20)
  label       String    @db.VarChar(60)
  position    Int
  createdAt   DateTime  @default(now())
  createdBy   String?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, field, value])
}

// Settings → Customer lifecycle: the workspace's lead stages. Contacts store `value` (Contact.leadStage), which never
// changes, so renaming or recolouring a stage keeps every contact on it. Progressing stages are in order (the chat's
// › button moves a contact to the next one); lost stages end the journey. New contacts start on the default stage.
// Created from the standard stages the first time a workspace needs them.
model LeadStage {
  id          String    @id @default(cuid())
  workspaceId String
  value       String    @db.VarChar(20)
  label       String    @db.VarChar(40)
  color       String    @db.VarChar(7)
  lost        Boolean   @default(false)
  position    Int
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  createdBy   String?
  updatedAt   DateTime  @updatedAt
  updatedBy   String?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, value])
}

// Settings → Contact properties → Add column: a property the workspace adds to every contact. `key` is made from
// the name (e.g. tyre_size) and never changes; `options` is a JSON array of choices for type "options".
model ContactCustomProperty {
  id          String               @id @default(cuid())
  workspaceId String
  name        String               @db.VarChar(60)
  key         String               @db.VarChar(40)
  // text | number | date | email | url | options | boolean
  type        String               @db.VarChar(20)
  options     String?              @db.Text
  createdAt   DateTime             @default(now())
  createdBy   String?
  updatedAt   DateTime             @updatedAt
  updatedBy   String?
  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  values      ContactCustomValue[]

  @@unique([workspaceId, key])
}

// A contact's value for one custom property (no row = empty)
model ContactCustomValue {
  contactId  String
  propertyId String
  value      String                @db.Text
  updatedAt  DateTime              @updatedAt
  updatedBy  String?
  contact    Contact               @relation(fields: [contactId], references: [id], onDelete: Cascade)
  property   ContactCustomProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([contactId, propertyId])
  @@index([propertyId])
}

// Settings → Contact properties → Default view: the workspace's column order and hidden columns (admins set it);
// everyone who isn't using a personal view sees it. No row = every property, standard order.
model ContactPropertyDefault {
  workspaceId String    @id
  order       String    @db.Text
  hidden      String    @db.Text
  // Renamed standard properties: JSON object { key: name } (e.g. {"companyName":"Garage name"})
  labels      String?   @db.Text
  updatedAt   DateTime  @updatedAt
  updatedBy   String?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model ContactPropertyView {
  userId      String
  workspaceId String
  personal    Boolean   @default(false)
  // JSON arrays of property keys (always written by the server)
  order       String    @db.Text
  hidden      String    @db.Text
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
}

// Backend log (services/logging.ts): one row per notable event - sign-ins, permission refusals, GraphQL mutations,
// changing REST requests and HTTP errors, WhatsApp/Meta API calls, webhooks, message sends and delivery statuses.
// Append-only and written by the server only. No relations on purpose: a log row must never block (or be removed
// by) deleting the workspace, user or message it mentions. Values are sanitized first (no passwords, tokens or
// secrets); customer numbers and message text are never logged. When the database can't be written, the same
// entry goes to the terminal instead.
model LogEntry {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  // SUCCESS | WARNING | ERROR
  level       String   @db.VarChar(10)
  // http | graphql | auth | permission | whatsapp | webhook | message | system
  category    String   @db.VarChar(20)
  // What happened, e.g. login.failed, whatsapp.send, message.status
  event       String   @db.VarChar(100)
  message     String   @db.Text
  // The request it belongs to (X-Request-Id), to follow one request through every event it caused
  requestId   String?  @db.VarChar(64)
  workspaceId String?
  userId      String?
  // AppError/GraphQL code (e.g. FORBIDDEN) or Meta's numeric error code (e.g. 131049)
  errorCode   String?  @db.VarChar(50)
  durationMs  Int?
  data        Json?

  @@index([createdAt])
  @@index([workspaceId, createdAt])
  @@index([level, createdAt])
  @@index([requestId])
}

// Push notifications (Firebase Cloud Messaging, services/push.ts): one row per phone app install, registered by the
// signed-in person (registerPushDevice) for the workspace they're signed in to. A token moves to whoever signs in on
// that phone next; signing out removes it; tokens Firebase reports as gone are deleted when a send fails.
// The id is a number (BIGINT UNSIGNED AUTO_INCREMENT); nothing refers to it (devices are found by token). An older
// table with a text id is changed by backups/pushdevice-id-bigint.sql; no createdBy/updatedBy.
model PushDevice {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  // FCM registration token (Firebase's id for this app install)
  token       String   @unique @db.VarChar(512)
  userId      String
  workspaceId String
  // android | ios
  platform    String   @db.VarChar(16)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([workspaceId, userId])
}

// A customer's vehicle. Belongs to one CRM contact; make, model, year and tyre size 1 are required (shown as its name,
// e.g. "Toyota Land Cruiser 2022"); the plate number is optional.
// lastServiceDate is no longer on the form but kept (existing data); editing a vehicle leaves it as it is.
// Audit: who added / last changed / deleted it and when (user ids); deleting sets deletedAt/deletedBy (soft delete).
// The id is a number (BIGINT UNSIGNED AUTO_INCREMENT), sent to the app as a string; nothing refers to it.
model Vehicle {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  workspaceId      String
  contactId        String
  plateNumber      String?   @db.VarChar(20)
  make             String?   @db.VarChar(60)
  model            String?   @db.VarChar(60)
  year             Int?
  registrationDate DateTime? @db.Date
  lastServiceDate  DateTime? @db.Date
  tireSize1        String    @db.VarChar(30)
  tireSize2        String?   @db.VarChar(30)
  // Free-text notes about this vehicle (team only)
  remarks          String?   @db.Text
  createdAt        DateTime  @default(now())
  createdBy        String?
  updatedAt        DateTime  @default(now()) @updatedAt
  updatedBy        String?
  deletedAt        DateTime?
  deletedBy        String?
  contact          Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([contactId, createdAt])
  @@index([workspaceId])
}

// Settings → Company settings → AI Robot (owners and admins only): automatic replies in unassigned chats. See
// services/aiRobot.ts.
model AiRobotSettings {
  workspaceId      String    @id
  enabled          Boolean   @default(false)
  // draft: the robot writes its reply (AI Robot tab) but sends nothing | live: it sends to the customer
  mode             String    @default("draft") @db.VarChar(10)
  // First reply when nobody from the team has answered the customer for this long
  firstReplyMins   Int       @default(5)
  // Once the robot has replied: wait this long for more quick messages, then answer them together (0 = at once)
  groupSeconds     Int       @default(8)
  // any | in_hours | out_hours (working hours from Simple automations, in the workspace time zone)
  hoursRule        String    @default("any") @db.VarChar(10)
  // Robot replies per chat in 24 hours before it hands the chat over
  maxRepliesPerDay Int       @default(20)
  minConfidence    Float     @default(0.7)
  webSearch        Boolean   @default(true)
  handoverMessage  String?   @db.Text
  // Facts about the business the robot may use (branches, hours, services, payment options, warranty)
  companyInfo      String?   @db.Text
  // One per line; a reply containing one is not sent
  bannedPhrases    String?   @db.Text
  createdAt        DateTime  @default(now())
  createdBy        String?
  updatedAt        DateTime  @updatedAt
  updatedBy        String?
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// One row per AI Robot decision in a chat: what it did and why (the chat tab's history, tuning and reports). The reply
// text is kept only for drafts (draft mode, nothing sent); a sent reply is the message itself (messageId).
model AiRobotRun {
  id             BigInt       @id @default(autoincrement())
  workspaceId    String
  conversationId String
  // reply | draft | handover | blocked | failed
  action         String       @db.VarChar(10)
  reason         String?      @db.Text
  confidence     Float?
  draft          String?      @db.Text
  // The tools the AI called for this decision, one per line (e.g. "search_tyres 245/40 R18: 5 of 9")
  tools          String?      @db.Text
  // The customer message it answered, and the message it sent (reply or handover)
  inMessageId    String?      @db.VarChar(191)
  messageId      String?      @db.VarChar(191)
  model          String       @db.VarChar(100)
  durationMs     Int
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([conversationId, createdAt])
}
