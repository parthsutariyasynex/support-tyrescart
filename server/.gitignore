node_modules
.env
*.db
*.db-journal
.env.*
!.env.example

# Raw DB dumps and migration backups contain real emails and password hashes -- never commit these.
# Already-tracked files under backups/ need a separate, explicit cleanup (see deployment plan).
backups/

# Images sent from the app (kept per workspace; never commit customer media)
uploads/

# Backend log files (logs/app-YYYY-MM-DD.log): kept on the server, never committed
logs/
