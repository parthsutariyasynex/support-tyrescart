PORT=4000
DATABASE_URL="mysql://supportusr:YOUR_PASSWORD@localhost:3306/supportdb"
JWT_SECRET=change-me-to-a-long-random-string
WEB_ORIGIN=http://localhost:3000

# From developers.facebook.com > your app
META_APP_SECRET=
# Any string you choose; enter the same value in Meta's webhook settings
META_VERIFY_TOKEN=my-verify-token
GRAPH_API_VERSION=v21.0

# New workspaces (sign-up without a team link, "Create workspace"). Default: off in production, on elsewhere.
# Admins add people from the Teams page; leave this unset in production.
# ALLOW_WORKSPACE_CREATION=false

# Public address of the web app, used in emailed links (e.g. password reset)
APP_URL=http://localhost:4000

# Email for "Forgot password" (any SMTP provider: Gmail app password, SendGrid, Amazon SES, ...)
# Leave SMTP_HOST empty in development to print reset links in the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="support-tyrescart <no-reply@yourdomain.com>"
