PORT=4000
DATABASE_URL="mysql://supportusr:YOUR_PASSWORD@localhost:3306/supportdb"
JWT_SECRET=change-me-to-a-long-random-string
WEB_ORIGIN=http://localhost:3000

# From developers.facebook.com > your app
META_APP_SECRET=
# Any string you choose; enter the same value in Meta's webhook settings
META_VERIFY_TOKEN=my-verify-token
GRAPH_API_VERSION=v21.0

# New workspaces (sign-up without a team link, "Create workspace"). Default: off in production, on elsewhere.
# Admins add people from the Teams page; leave this unset in production.
ALLOW_WORKSPACE_CREATION=false

# Minutes between assignment reminder toasts for open chats still waiting for a reply (default 5, 0 = off)
ASSIGNMENT_REMINDER_MINUTES=5

# Minutes without activity before a connected person shows as Away (presence dots)
PRESENCE_AWAY_MINUTES=5

# Public address of the web app, used in emailed links (e.g. password reset)
APP_URL=http://localhost:4000

# Email for "Forgot password" (any SMTP provider: Gmail app password, SendGrid, Amazon SES, ...)
# Leave SMTP_HOST empty in development to print reset links in the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="support-tyrescart <no-reply@yourdomain.com>"

# Product name shown in emails (the web app reads NEXT_PUBLIC_APP_NAME)
APP_NAME=support-tyrescart

# Folder for copies of images sent from the chat (default: ./uploads next to the server). Back it up.
# UPLOADS_DIR=/var/lib/support-tyrescart/uploads

# Optional: your Meta app id. Only needed to create WhatsApp templates with an image, video or document header
# (Meta asks for a sample file, uploaded through the app). Settings → Templates explains it when it's missing.
META_APP_ID=

# Backend logs (LogEntry table): how many days they are kept (default 90), and what the daily clean-up does with
# older ones: dry-run (default: only counts and reports them), delete, or off. Check first: npm run logs:retention
# LOG_RETENTION_DAYS=90
# LOG_RETENTION_MODE=dry-run
# The same logs as daily files of JSON lines, logs/YYYY-MM-DD.log (default folder: logs/ where the server runs).
# Old files follow the same retention. LOG_TO_FILE=false turns the files off.
# LOG_DIR=/var/log/support-tyrescart
# LOG_TO_FILE=true

# Location messages (📎 → Location). Address search uses an OpenStreetMap Nominatim server: by default the free public
# one (max 1 request a second, no search-as-you-type, results cached by this server; its usage policy applies:
# https://operations.osmfoundation.org/policies/nominatim/). Set your own/hosted Nominatim, or "off" to hide search.
# GEOCODER_URL=https://nominatim.openstreetmap.org
# A contact email or URL sent with search requests (the public server asks apps to identify themselves)
# GEOCODER_CONTACT=support@yourdomain.com
# Live location: the address customers open the app at (links in live location messages start with it;
# defaults to WEB_ORIGIN). Must be https in production (browsers only share location over https).
# PUBLIC_APP_URL=https://support.yourdomain.com
# Map pictures on the public live location page (a {z}/{x}/{y} tile server, and its required credit line)
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_ATTRIBUTION=© OpenStreetMap contributors
